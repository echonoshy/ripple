# Ripple 配置文件示例
#
# 复制本文件为 config/settings.yaml 后，填入本地真实密钥。
# 不要把包含真实密钥的 config/settings.yaml 提交到仓库。

# 模型配置
model:
  # 默认 Codex 预设
  default: "codex-medium"

  # 当前模型因容量、可用性或模型级上游错误失败，且尚无输出/工具副作用时，按顺序静默降级。
  # 删除或设为空列表可禁用自动降级。
  fallback_chain:
    - model: "deepseek-v4-flash-260425"
      reasoning_effort: "low"
    - model: "doubao-seed-2-0-code-preview-260215"
      reasoning_effort: "low"

  # 模型预设（/models 查看，/model <别名> 切换）
  # reasoning_effort 目前作为 UI/响应元数据保留，实际执行由 Codex app-server 处理。
  presets:
    codex-low:
      openai-codex: "glm-latest"
      reasoning_effort: "low"
    codex-medium:
      openai-codex: "glm-latest"
      reasoning_effort: "medium"
    codex-high:
      openai-codex: "glm-latest"
      reasoning_effort: "high"
    codex-xhigh:
      openai-codex: "glm-latest"
      reasoning_effort: "xhigh"

# Codex app-server runner 配置
#
# Ripple 管理 user sandbox、任务状态、事件日志和生命周期；实际执行交给
# 服务端预装的 Codex app-server。当前版本只接入 Codex。
#
# Codex 由管理员在服务端安装一次。当前实现维护按 user/workspace/generation
# 隔离的 app-server worker pool；job 运行时借用 worker，完成后进入 idle
# 状态；chat 连续上下文通过持久 Codex thread id 延续。
#
# Codex app-server 是服务端受信宿主进程；Codex shell 命令由 Codex Linux
# sandbox/bubblewrap 和 Ripple managed permissions profile 约束，只应访问当前
# user workspace、允许的 runtime/tool 只读路径和必要 cache。服务端 CODEX_HOME
# 和整个 sandboxes root 必须 deny-read，启动前 runtime probe 失败时拒绝执行。
external_agents:
  codex:
    enabled: true
    codex_executable: "codex"
    # Ripple 启动 app-server 时会额外追加 -c 覆盖项，默认关闭 Codex native
    # apps/plugins/bundled skill instructions，并启用 request_permissions_tool /
    # exec_permission_approvals，让目录外访问通过 Ripple approval bridge 审批。
    app_server_args: ["app-server", "--listen", "stdio://"]
    # 独立服务端 CODEX_HOME。管理员用
    #   CODEX_HOME=/path/to/.ripple/codex-service-home codex login
    # 登录一次；不要复用开发者个人 ~/.codex，避免继承 yolo/danger-full-access 配置。
    codex_home: ".ripple/codex-service-home"
    # 可选：把 Codex app-server 的 state/logs/goals/memories SQLite 放到本地盘。
    # 路径下按 users/<user_id>/sqlite/ 隔离；不要放 NFS。省略时保持与 codex_home
    # 同级的 codex-runtime/ 兼容路径。
    # sqlite_root: ".ripple/codex-sqlite"
    approval_policy:
      granular:
        sandbox_approval: true
        rules: false
        skill_approval: false
        request_permissions: true
        mcp_elicitations: false
    sandbox_type: "workspace-write"
    network_access: true
    max_workers_per_pool: 50
    max_total_pool_workers: 256
    # 空闲 worker 超过该时间后由 idle reaper 关闭。
    idle_timeout_seconds: 1800
    # Codex runtime trace 日志不参与对话恢复；生产环境默认只短期保留，避免
    # logs_2.sqlite 随用户量膨胀。超过大小上限时会清空该日志库并 VACUUM。
    runtime_log_retention_seconds: 86400
    runtime_log_max_mb: 64
    runtime_log_cleanup_interval_seconds: 3600

# 日志配置
# Ripple Server 日志只写 stdout/stderr；生产部署由 systemd/journald、
# Docker 或外部日志采集系统负责持久化、轮转和检索。
# RUST_LOG 环境变量优先级高于这里的 level。
logging:
  level: "INFO"

# Server 配置
server:
  host: "0.0.0.0"
  port: 8810
  # SQLite 连接池上限。SQLite 仍只有一个写者；此值用于避免短查询在高并发下
  # 因等待空闲连接而过早失败。
  storage:
    sqlite_max_connections: 50
  # 用户 connector 暴露 allowlist。省略时为兼容旧配置，会启用全部内置 connector。
  # 下例只暴露飞书；运行时 Codex 能力不受此列表影响。
  enabled_connectors:
    - "feishu"
  security:
    # v1 推荐单机 trusted-proxy 部署：浏览器只访问上游 Web/proxy，
    # proxy 完成用户认证后注入 X-Ripple-User-Id，并剥离客户端伪造 header。
    deployment_mode: "trusted-proxy"
    require_confirm_for_risky_api: true
    # 远程生产恢复 HTTPS 域名后建议设为 true；当前临时 HTTP IP 直连阶段保持 false。
    require_https: false
  user_auth:
    # 轻量产品壳：启用后浏览器用户可用邀请码 + 账号密码登录，后端把
    # session token 绑定到 opaque user_id，并忽略客户端伪造的 X-Ripple-User-Id。
    # 关闭时保持原 service API key + trusted header 模式。
    enabled: false
    session_ttl_seconds: 2592000
  api_docs:
    # 生成式 OpenAPI/Swagger 文档入口：
    #   GET /openapi.json
    #   GET /docs
    # 文档只暴露接口元数据，不包含 API key；真正调用 /v1 仍需鉴权。
    enabled: true
    try_it_out_enabled: true
  cors:
    # 默认不开放浏览器跨域。若必须让独立 Web 前端直连 API，只填明确 origin。
    allowed_origins: []
    allow_any_origin: false
  # /v1/chat/completions 启动当前 job 的宿主 Codex app-server，并以当前 user
  # workspace 为 cwd；具体 shell 命令仍由 Codex Linux sandbox 约束。
  codex_chat:
    max_runtime_seconds: 3600
  # chat 侧任务触发器创建意图的结构化提取超时。
  task_trigger_extraction:
    max_runtime_seconds: 120
  task_triggers:
    # Ripple only checks due task trigger metadata and starts Codex runs.
    # User work still executes through Codex app-server.
    poll_interval_seconds: 15
  document_preview:
    # PDF files render directly. Word/Excel/PowerPoint files are converted to PDF
    # with LibreOffice and cached outside user workspaces.
    cache_root: ".ripple/sandboxes-cache/previews"
    libreoffice_path: "soffice"
    max_source_bytes: 67108864
    conversion_timeout_seconds: 120
  # 浏览器能访问到的后端根地址。配置后 gogcli Google OAuth 可以由后端自动接收
  # callback 并完成授权，用户不再需要复制 127.0.0.1 回调 URL。
  # 本机开发可用: "http://localhost:8810"
  # 远程部署请填写公网 HTTPS 地址，并在 GCP Web OAuth Client 里把下方完整
  # callback URL 加到 Authorized redirect URIs。
  # public_base_url: "http://localhost:8810"
  feishu:
    # 推荐：部署方统一配置一次 Feishu/Lark app，普通用户只需要在浏览器里登录授权。
    # 不配置时，Feishu connector 会 fallback 到 lark-cli 的 setup URL，让管理员/高级用户
    # 点击链接创建当前 workspace 专用 app。
    #
    # app:
    #   app_id: "<FEISHU_APP_ID>"
    #   app_secret: "<FEISHU_APP_SECRET>"
    #   brand: "feishu"
    # 授权 profile 只在服务端使用；客户端和 connector-auth 报文都不传 scope。
    # 默认按 im / task / mail / docs 拆成四个独立 profile。每次授权只覆盖当前
    # 基础流程，但 profile 内包含完成该流程所需的跨 API 依赖，避免执行中途补权。
    # 无法判断或只是“连接飞书”时走
    # lark-cli --recommend。profile id 应保持简短、稳定且与业务能力对应。
    # authorization_profiles:
    #   - id: "im"
    #     scopes:
    #       - "contact:user:search"
    #       - "im:message"
    #       - "im:message.send_as_user"
    #       - "im:message:readonly"
    #       - "im:chat:read"
    #   - id: "task"
    #     scopes:
    #       - "contact:user.basic_profile:readonly"
    #       - "contact:user.base:readonly"
    #       - "contact:user:search"
    #       - "task:task:read"
    #       - "task:task:write"
    #       - "task:tasklist:read"
    #       - "task:tasklist:write"
    #   - id: "mail"
    #     scopes:
    #       - "mail:user_mailbox:readonly"
    #       - "mail:user_mailbox.message:readonly"
    #       - "mail:user_mailbox.message:send"
    #       - "mail:user_mailbox.message:modify"
    #   - id: "docs"
    #     scopes:
    #       - "docx:document:create"
    #       - "docx:document:readonly"
    #       - "docx:document:write_only"
  gogcli_oauth:
    # 推荐：部署方配置一次 Google OAuth Client，最终用户只需要打开授权 URL 点 Allow。
    # Google Cloud Console 中创建 OAuth Client 时使用 Web application，并把下面 callback URL
    # 加到 Authorized redirect URIs:
    #   <server.public_base_url>/v1/sandboxes/gogcli/oauth/callback
    #
    # client:
    #   type: "web"
    #   client_id: "<GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
    #   client_secret: "<GOOGLE_OAUTH_CLIENT_SECRET>"
    #   project_id: "<GCP_PROJECT_ID>"  # 可选，仅用于生成标准 client_secret.json 形状
    #
    # 也支持直接粘贴 Google 下载的 client_secret JSON（管理员侧配置，不让最终用户粘贴）:
    # client_secret_json: |
    #   {"web":{"client_id":"...","client_secret":"..."}}
    #
    # 通常保持 true。设为 false 会禁用全局 client 自动注册；普通用户授权会返回服务端配置错误。
    auto_register_client: true
    # 未显式配置 public_base_url/callback_url 时，自动使用当前 API 请求的 Host
    # 生成 callback URL。Web UI、localhost、端口转发、常规反向代理通常都适用；
    # 如果你的 API Host 不是用户浏览器可访问地址，可设为 false，并显式配置
    # public_base_url 或 callback_url。
    auto_from_request: true
    # 优先级高于 public_base_url。通常保持注释，让系统使用:
    #   <server.public_base_url>/v1/sandboxes/gogcli/oauth/callback
    # callback_url: "http://localhost:8810/v1/sandboxes/gogcli/oauth/callback"
  api_keys:
    # Service API key for trusted upstream services. If user_auth is disabled,
    # callers pass a verified X-Ripple-User-Id for isolation. If user_auth is
    # enabled, browser users normally use their session token instead.
    - "<RIPPLE_SERVER_API_KEY>"

  # 沙箱配置（nsjail）
  sandbox:
    # user 运行时根目录（每个 user 的 nsjail.cfg + credentials + sessions/）
    # sandboxes_root: ".ripple/sandboxes"
    # user workspace 存储根目录。默认不配置，继续使用:
    #   .ripple/sandboxes/<user_id>/workspace
    # 正式部署到 NAS 时可改成挂载目录，例如:
    #   /mnt/ripple-workspaces
    # workspaces_root: "/mnt/ripple-workspaces"
    # 跨 user 共享的包管理器缓存（uv / corepack / pnpm）
    # caches_root: ".ripple/sandboxes-cache"
    # 跨 user 共享的只读 Python 依赖环境（由 python/python3 wrapper 创建和复用）
    # python_envs_root: ".ripple/sandboxes-cache/python-envs"
    # python_env_uv_cache: ".ripple/sandboxes-cache/uv-cache"
    # python_env_max_packages: 20

    # 空闲自动挂起时间（秒），默认 30 分钟
    idle_suspend_seconds: 1800

    # 挂起后磁盘保留时间（秒），默认 7 天
    retention_seconds: 604800

    # workspace 磁盘配额（MB）
    max_workspace_mb: 2048

    # /tmp tmpfs 大小（MB），uv 下载临时文件需要足够空间
    tmpfs_size_mb: 512

    # PyPI 镜像 URL（设置为空字符串则使用官方源）
    pypi_mirror_url: "https://pypi.tuna.tsinghua.edu.cn/simple"

    # 特殊 connector CLI 仅在对应 connector 启用时挂载。
    lark_cli_install_root: "vendor/lark-cli"

    # 通用 skill + bin 工具。每个工具以只读方式挂载进 sandbox，并把 bin_dirs 加入 PATH。
    # 后续新增 youtube-cli 等工具时，只需放置二进制并新增一段配置。
    cli_tools: []
    # cli_tools:
    #   - name: bilibili
    #     install_root: "vendor/bilibili-cli"
    #     sandbox_root: "/opt/bilibili-cli"
    #     bin_dirs:
    #       - "current/bin"
    #   - name: podcast
    #     install_root: "vendor/podcast-cli"
    #     sandbox_root: "/opt/podcast-cli"
    #     bin_dirs:
    #       - "current/bin"

# Skills 配置
skills:
  # 共享 skill 目录（所有 Server session 可见）
  # 支持 glob：skills/* 会展开为所有顶层子目录；也可写具体路径如 skills/lark
  # 路径相对于项目根目录，或使用 ~ 展开为绝对路径
  shared_dirs:
    - "skills/lark"
    - "skills/record-artifact-synthesis"
  # 对所有用户的完整 Record 摘要/脑图/标题生成请求自动选择该 skill。
  auto_select_record_artifact_synthesis: true
