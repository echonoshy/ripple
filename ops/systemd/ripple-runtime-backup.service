[Unit]
Description=Backup Ripple runtime state to NAS
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/home/lake/workspace/ripple/.ripple
ConditionPathIsMountPoint=/nas

[Service]
Type=oneshot
User=lake
Group=lake
WorkingDirectory=/home/lake/workspace/ripple
Environment=RIPPLE_BACKUP_SOURCE=/home/lake/workspace/ripple/.ripple
Environment=RIPPLE_BACKUP_NAS_MOUNT=/nas
Environment=RIPPLE_BACKUP_DEST=/nas/ripple-backups/ripple-runtime
ExecStart=/home/lake/workspace/ripple/scripts/backup-ripple-runtime-to-nas.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
