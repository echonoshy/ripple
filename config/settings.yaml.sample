# Ripple 配置文件示例
#
# 复制本文件为 config/settings.yaml 后，填入本地真实密钥。
# 不要把包含真实密钥的 config/settings.yaml 提交到仓库。

# Codex 账号与模型元数据配置
api:
  # 当前只保留 Codex provider 元数据；实际执行通过 external_agents.codex app-server。
  provider: "openai-codex"

  providers:
    # 仅作为模型 preset 的 provider 元数据；真实授权由服务端 Codex CLI 登录态提供。
    openai-codex:
      type: "codex-app-server"

# 模型配置
model:
  # 默认 Codex 预设
  default: "codex-medium"

  # 模型预设（/models 查看，/model <别名> 切换）
  # reasoning_effort 目前作为 UI/响应元数据保留，实际执行由 Codex app-server 处理。
  presets:
    codex-low:
      openai-codex: "gpt-5.5"
      reasoning_effort: "low"
    codex-medium:
      openai-codex: "gpt-5.5"
      reasoning_effort: "medium"
    codex-high:
      openai-codex: "gpt-5.5"
      reasoning_effort: "high"
    codex-xhigh:
      openai-codex: "gpt-5.5"
      reasoning_effort: "xhigh"

# Agent 配置
agent:
  max_turns: 200
  session_prefix: "ripple"

# 内部用户配额配置（非 billing）
users:
  quota_defaults:
    max_workspace_mb: 2048
    max_sessions: 200
    max_runs_per_day: 200
    max_run_runtime_seconds: 3600

# Codex app-server runner 配置
#
# Ripple 管理 user sandbox、任务状态、事件日志和生命周期；实际执行交给
# 服务端预装的 Codex app-server。当前版本只接入 Codex。
#
# Codex 由管理员在服务端安装一次。Ripple 会为每个 user_id 懒启动独立
# app-server 进程，每个任务创建独立 thread/turn。
#
# 开发/MVP 模式下 Codex 是当前 user sandbox 内的受信执行器：可访问该
# user 的 workspace、skills、credentials，但不应看到其他 user 的 sandbox。
external_agents:
  default_provider: "codex"
  codex:
    enabled: true
    codex_executable: "codex"
    app_server_args: ["app-server", "--listen", "stdio://"]
    # 独立服务端 CODEX_HOME。管理员用
    #   CODEX_HOME=/path/to/.ripple/codex-service-home codex login
    # 登录一次；不要复用开发者个人 ~/.codex，避免继承 yolo/danger-full-access 配置。
    codex_home: ".ripple/codex-service-home"
    approval_policy: "never"
    sandbox_type: "workspace-write"
    allow_danger_full_access: false
    network_access: true
    idle_timeout_seconds: 1800
    # 可选：控制 Codex app-server 子进程环境。不要传入 server 级密钥；
    # user 级 token 应放在当前 user sandbox 可见的 credentials/workspace 配置中。
    # env:
    #   PATH: "/usr/local/bin:/usr/bin:/bin"

# 日志配置
#   ripple.log — 唯一主日志。HTTP / session / agent / Codex / sandbox 事件
#                按同一请求时间线写入，方便用 req= 或 session= grep 排查。
#
# 格式固定为人类可读：
#   YYYY-MM-DD HH:mm:ss.SSS LEVEL req=<request_id> user=<user_id> session=<session_id> module=<module> | event=...
#
# rotation / retention 走 loguru 语义：
#   rotation  — 单文件轮转阈值，支持 "50 MB" / "100 MB" / "00:00"（每日零点）
#   retention — 轮转后保留策略，支持 "14 days" / "30 days" 或保留文件个数（int）
logging:
  level: "DEBUG"
  rotation: "50 MB"
  retention: "14 days"

# Server 配置
server:
  host: "0.0.0.0"
  port: 8810
  # /v1/chat/completions 直接启动当前 user sandbox 内的 Codex app-server。
  codex_chat:
    max_runtime_seconds: 3600
  schedules:
    # Ripple only checks due schedule metadata and starts Codex runs.
    # User work still executes through Codex app-server.
    poll_interval_seconds: 15
  # 浏览器能访问到的后端根地址。配置后 gogcli Google OAuth 可以由后端自动接收
  # callback 并完成授权，用户不再需要复制 127.0.0.1 回调 URL。
  # 本机开发可用: "http://localhost:8810"
  # 远程部署请填写公网 HTTPS 地址，并在 GCP Web OAuth Client 里把下方完整
  # callback URL 加到 Authorized redirect URIs。
  # public_base_url: "http://localhost:8810"
  feishu:
    # 推荐：部署方统一配置一次 Feishu/Lark app，普通用户只需要在浏览器里登录授权。
    # 不配置时，Feishu connector 会 fallback 到 lark-cli 的 setup URL，让管理员/高级用户
    # 点击链接创建当前 workspace 专用 app。
    #
    # app:
    #   app_id: "<FEISHU_APP_ID>"
    #   app_secret: "<FEISHU_APP_SECRET>"
    #   brand: "feishu"
  gogcli_oauth:
    # 推荐：部署方配置一次 Google OAuth Client，最终用户只需要打开授权 URL 点 Allow。
    # Google Cloud Console 中创建 OAuth Client 时使用 Web application，并把下面 callback URL
    # 加到 Authorized redirect URIs:
    #   <server.public_base_url>/v1/sandboxes/gogcli/oauth/callback
    #
    # client:
    #   type: "web"
    #   client_id: "<GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
    #   client_secret: "<GOOGLE_OAUTH_CLIENT_SECRET>"
    #   project_id: "<GCP_PROJECT_ID>"  # 可选，仅用于生成标准 client_secret.json 形状
    #
    # 也支持直接粘贴 Google 下载的 client_secret JSON（管理员侧配置，不让最终用户粘贴）:
    # client_secret_json: |
    #   {"web":{"client_id":"...","client_secret":"..."}}
    #
    # 通常保持 true。设为 false 会禁用全局 client 自动注册；普通用户授权会返回服务端配置错误。
    auto_register_client: true
    # 未显式配置 public_base_url/callback_url 时，自动使用当前 API 请求的 Host
    # 生成 callback URL。Web UI、localhost、端口转发、常规反向代理通常都适用；
    # 如果你的 API Host 不是用户浏览器可访问地址，可设为 false，并显式配置
    # public_base_url 或 callback_url。
    auto_from_request: true
    # 优先级高于 public_base_url。通常保持注释，让系统使用:
    #   <server.public_base_url>/v1/sandboxes/gogcli/oauth/callback
    # callback_url: "http://localhost:8810/v1/sandboxes/gogcli/oauth/callback"
  api_keys:
    - "<RIPPLE_SERVER_API_KEY>"
  session:
    ttl_seconds: 3600

  # 沙箱配置（nsjail）
  sandbox:
    # user 沙箱根目录（每个 user 的 workspace + nsjail.cfg + credentials + sessions/）
    # sandboxes_root: ".ripple/sandboxes"
    # 跨 user 共享的包管理器缓存（uv / corepack / pnpm）
    # caches_root: ".ripple/sandboxes-cache"

    # 空闲自动挂起时间（秒），默认 30 分钟
    idle_suspend_seconds: 1800

    # 挂起后磁盘保留时间（秒），默认 7 天
    retention_seconds: 604800

    # workspace 磁盘配额（MB）
    max_workspace_mb: 2048

    # /tmp tmpfs 大小（MB），uv 下载临时文件需要足够空间
    tmpfs_size_mb: 512

    # PyPI 镜像 URL（设置为空字符串则使用官方源）
    pypi_mirror_url: "https://pypi.tuna.tsinghua.edu.cn/simple"

    # 资源限制
    resource_limits:
      max_memory_mb: 4096
      max_file_size_mb: 1024
      max_pids: 512
      command_timeout: 120

# 外部服务配置（第三方 API）
services:
  # Shazam 音乐识别 API（用于 skills/podcast/music-identify）
  shazam:
    api_key: "<SHAZAM_API_KEY>"
    base_url: "https://shazam-api.com/api"
    # 连接超时（秒），TCP 握手 + TLS
    connect_timeout: 10
    # 读超时（秒），等待服务端响应首字节/后续数据
    request_timeout: 60
    # 写超时（秒），上传 mp3 文件时的 write 阶段；大文件建议 120+
    write_timeout: 120
    # 轮询总超时（秒）
    poll_timeout: 60
    # 轮询间隔（秒）
    poll_interval: 3


# Skills 配置
skills:
  # 共享 skill 目录（所有 Server session 可见）
  # 支持 glob：skills/* 会展开为所有顶层子目录；也可写具体路径如 skills/lark
  # 路径相对于项目根目录，或使用 ~ 展开为绝对路径
  shared_dirs:
    - "skills/*"
