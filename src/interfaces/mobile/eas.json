{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "RIPPLE_ANDROID_USES_CLEARTEXT": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "RIPPLE_ANDROID_USES_CLEARTEXT": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    }
  }
}
