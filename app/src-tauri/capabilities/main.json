{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Ripple window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "ripple-browser:allow-open",
    "ripple-browser:allow-resize",
    "ripple-browser:allow-navigate",
    "ripple-browser:allow-reload",
    "ripple-browser:allow-print-page",
    "ripple-browser:allow-set-zoom",
    "ripple-browser:allow-clear-data",
    "ripple-browser:allow-back",
    "ripple-browser:allow-forward",
    "ripple-browser:allow-capture",
    "ripple-browser:allow-run-automation",
    "ripple-browser:allow-close",
    "ripple-browser:allow-show",
    "ripple-browser:allow-hide"
  ]
}
